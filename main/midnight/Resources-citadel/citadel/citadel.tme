            <time id="15"  normal="#d4d4d4d4" />
            <time id="16"  normal="#acacacac" />
        </people>
        
        <terrain>
            <time id="0"   fill="#000000" outline="#a50000" />
            <time id="1"   fill="#ffffff" outline="#a50000" />
            <time id="2"   fill="#ffffff" outline="#a50000" />
            <time id="3"   fill="#ffffff" outline="#a50000" />
