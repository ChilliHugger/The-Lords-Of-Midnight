;-------------------------------------------------------------------------
; Reaction & Purpose definition macros
;-------------------------------------------------------------------------
MACRO DEFINE_PURPOSE purpose
PROC purpose NEAR
ENDM

MACRO END_PURPOSE
	ret
ENDP
ENDM

MACRO DEFINE_REACTION reaction
PROC reaction NEAR
for_count	=	0
ENDM

MACRO END_REACTION
	ret
ENDP
ENDM

;-------------------------------------------------------------------------
; Control Flow macros
;-------------------------------------------------------------------------

;-------------------------------------------------------------------------
; Carry flag is used throughout as a true/false flag
; STC (set)   : TRUE
; CLC (unset) : FALSE
;-------------------------------------------------------------------------

;-------------------------------------------------------------------------
; logical NOT (NOT TRUE) : invert truth
MACRO NOTT
	cmc
ENDM

;-------------------------------------------------------------------------
; make this the next state
MACRO GO_STATE state
	mov	[WORD esi+obj_reaction],state
	stc
	ret
ENDM

;-------------------------------------------------------------------------
; branch if false
MACRO BIFF label
	jnc	@@&label
ENDM

;-------------------------------------------------------------------------
; branch anyway
MACRO BRA label
	jmp	@@&label
ENDM

;-------------------------------------------------------------------------
; branch if true
MACRO BIFT label
	jc	@@&label
ENDM

;-------------------------------------------------------------------------
; define a label
MACRO LAB label
@@&label:
ENDM

;-------------------------------------------------------------------------
; FALSE condition
MACRO FALSE
	clc
ENDM

;-------------------------------------------------------------------------
; TRUE condition
MACRO TRUE
	stc
ENDM

;-------------------------------------------------------------------------
; is > than
MACRO IS_GT value
	cmp	eax,value		;;carry set if ax > value
ENDM

;-------------------------------------------------------------------------
; is < than
MACRO IS_LT value
	cmp	eax,value
	jne	@@cl
     	cmc				;;reverse case if ==
@@cl:
	cmc
ENDM

MACRO ARE_QUESTING
	cmp	[WORD obj_quest+esi],_qrest	;;are we waiting?
	ZtoC
	cmc
ENDM

MACRO SET_AVAILABLE
	or	[WORD esi+obj_flags],available_bit	;;available to quest
ENDM

MACRO CLEAR_AVAILABLE
	and	[WORD esi+obj_flags],NOT available_bit	;;unavailable to quest
ENDM

;FOR / NEXT / LIST_ENTRY not used (yet)
;Limitations:
;	1. Nesting of FOR loops is NOT ALLOWED
;	2. No references to SELF allowed inside FOR loop
;	3. They don't work anyway! (unless you only use 1 per fn)
MACRO FOR

	push	esi
	movzx	ecx,[list_count]
	mov	[list_posn],offset list_buffer
	push	ecx
for_label	CATSTR <@@for>,%for_count,<:>
for_label
ENDM

MACRO LIST_ENTRY
	mov	esi,[list_posn]
	mov	esi,[esi]
	mov	[last_result],esi
ENDM

MACRO NEXT
for_label	CATSTR <@@for>,%for_count
	add	[list_posn],4
	pop	ecx
	loop	for_label
	pop	esi
for_count	=	(for_count+1)
ENDM


;-------------------------------------------------------------------------
; Conditions to be evaluated
;-------------------------------------------------------------------------
MACRO ANY_NEARLAND state
	mov	eax,state
	call	check_nearland_state
ENDM

MACRO AT_STRONGHOLD check
	mov	eax,check
	call	check_at_stronghold
ENDM

MACRO BATTLE_ODDS ratio1,ratio2
	mov	eax,ratio1
	mov	edx,ratio2
	call	check_battle_odds
ENDM

MACRO CONV_LIST switch
	mov	eax,switch
	call	conv_list_rout
ENDM

MACRO DEAD who
	mov	eax,who
	call	is_dead
ENDM

MACRO FELLOW_LORD_RECRUITING
	call	check_fellow_lord_quest
ENDM

MACRO GEN_LIST condition
	mov	eax,condition
	call	generate_list
ENDM

MACRO GET_ATTACKER
	mov	edi,[attacker]
ENDM

MACRO GET_OWN_CIT_RULER
	call	get_cit_ruler
ENDM

MACRO GO_STATE state
	mov	[WORD esi+obj_reaction],state
	TRUE		;;further processing required
ENDM

MACRO HOMELAND check
	movzx	eax,[BYTE obj_start_land+esi]
	mov	eax,[citadel_list+eax*4]
	cmp	[BYTE eax+citadel_list+obj_land_war_state],check
	ZtoC
ENDM

MACRO IN_ADJACENT_LAND who
	mov	eax,who
	call	adjacent_check
ENDM

MACRO IN_HOMELAND who
	mov	eax,who
	call	homeland_check
ENDM

MACRO IN_NEARLAND who
	mov	eax,who
	call	nearland_check
ENDM

MACRO IN_SAMELAND who
	mov	eax,who
	call	sameland_check
ENDM

MACRO IS_EMPTY_LIST
	push	eax
	test	[list_count],-1
	ZtoC
	pop	eax
ENDM

MACRO PICK_FROM_LIST
	call	pick_list_entry
ENDM

MACRO PURPOSE who,what
	mov	eax,who
	mov	edx,what
	call	check_purpose
ENDM

MACRO REACTION who,what
	mov	eax,who
	mov	edx,what
	call	check_reaction
ENDM

MACRO SET_QUEST type,where
	mov	eax,type
	mov	edx,where
	call	setup_quest_data
	FALSE				;;no further processing
ENDM

MACRO SOMEONE_TO_RECRUIT
	call	check_recruitables
ENDM

MACRO STATE what
;;	IFE what-NEARLAND
;;	ENDIF
	mov	eax,what
	cmp	eax,MY_HOMELAND
@@p:
	jne	@@p

	movzx	eax,[BYTE obj_start_land+esi]
	mov	eax,[citadel_list+eax*4]
	movzx	eax,[BYTE citadel_list+obj_land_war_state+eax]
ENDM

MACRO SUB_LIST condition
	mov	eax,condition
	call	subject_list
ENDM

