rsd q_ignorant
rsd q_sceptical
rsd q_thick_skinned
rsd q_feeble_warrior
rsd q_pitiful_leader


;
; Bit Numbers
;
rs_set 0
rs q_brave_bit,1
rs q_far_sighted_bit,1
rs q_selfish_bit,1
