; This generates 1,2,4,8,16...
MACRO rsd_set
rscount		=	1
ENDM

MACRO rsd a
a	=	rscount
	IF (rscount-080000000h)
rscount	=	(rscount*2)
	ENDIF
ENDM

;
; Values
;
rsd_set
rsd q_brave
rsd q_far_sighted
rsd q_selfish
rsd q_bold
rsd q_kind
rsd q_warm_hearted
rsd q_gentle
rsd q_generous

rsd q_quick_witted
rsd q_talkative
rsd q_home_loving
rsd q_eager
rsd q_energetic
rsd q_tireless
rsd q_modest
rsd q_passionate

rsd q_reliable
rsd q_galland
rsd q_charming
rsd q_loyal
rsd q_gregarios
rsd q_peaceable
rsd q_polite
rsd q_submissive

rsd q_patient
